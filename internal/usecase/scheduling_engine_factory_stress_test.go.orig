package usecase

// =============================================================================
// T11 – STRESS TEST: HỆ THỐNG F (FACTORY) CUNG CẤP CHO S (STORE)
//
// Mục tiêu sản xuất mỗi ngày:
//   - Vỏ bánh burger  : 200 cái   (SOP: sop_bun)
//   - Patty bò        : 300 miếng (SOP: sop_patty)
//   - Nước xốt burger : 1 lô (1L) (SOP: sop_sauce)
//
// Thiết bị:
//   - 2 máy nướng cỡ lớn (m_grill_A, m_grill_B), mỗi máy 24 slots
//
// Nhân viên ca sáng F:
//   - f_staff_1, f_staff_2, f_staff_3 (3 người)
//
// Kịch bản stress:
//   SC-1  Happy Path           – đủ người, đủ máy, đúng giờ
//   SC-2  Machine Down (A)     – m_grill_A hỏng giữa chừng, chỉ còn máy B
//   SC-3  Staff Shortage       – chỉ 1 nhân viên thay vì 3
//   SC-4  Rush Order           – nhận thêm 60 patty gấp lúc 10:00
//   SC-5  Full Blast           – tất cả PO bắt đầu cùng lúc, tài nguyên bị
//                                tranh chấp tối đa
// =============================================================================

import (
	"fmt"
	"sort"
	"strings"
	"testing"
	"time"

	"one-system-server/internal/domain/models"
)

// ─── HELPERS ──────────────────────────────────────────────────────────────────

func ptrStrF(s string) *string { return &s }
func ptrIntF(i int) *int       { return &i }

// Các SOP step name cho báo cáo virtual timeline
var factoryStepNames = map[string]string{
	// Vỏ bánh burger (bun)
	"bun_s1_dry":   "Cân nguyên liệu khô (bún)",
	"bun_s2_mix":   "Trộn bột bún",
	"bun_s3_proof": "Ủ bột bún",
	"bun_s4_shape": "Tạo hình bánh",
	"bun_s5_bake":  "Nướng bánh bún",
	"f3_bun_dry":   "Cân nguyên liệu khô vỏ bánh",
	"f3_bun_mix":   "Trộn bột vỏ bánh",
	"f3_bun_proof": "Ủ bột vỏ bánh",
	"f3_bun_shape": "Tạo hình vỏ bánh",
	"f3_bun_bake":  "Nướng vỏ bánh",

	// Patty bò
	"patty_s1_prep":  "Chuẩn bị nguyên liệu bò",
	"patty_s2_mix":   "Trộn bò xay",
	"patty_s3_weigh": "Chia & cân từng viên 120g",
	"patty_s4_mold":  "Tạo hình bằng khuôn",
	"patty_s5_grill": "Nướng patty bò",
	"f3_patty_prep":  "Chuẩn bị nguyên liệu bò",
	"f3_patty_mix":   "Trộn bò xay",
	"f3_patty_weigh": "Chia & cân bò viên 120g",
	"f3_patty_mold":  "Tạo hình patty bằng khuôn",
	"f3_patty_grill": "Nướng patty bò",

	// Nước xốt burger
	"sauce_s1_prep": "Chuẩn bị nguyên liệu xốt",
	"sauce_s2_mix":  "Trộn & nêm xốt",
	"sauce_s3_pack": "Đóng gói xốt – QC",
	"f3_sauce_prep": "Chuẩn bị nguyên liệu xốt",
	"f3_sauce_mix":  "Trộn & nêm xốt",
	"f3_sauce_pack": "Đóng gói xốt – QC",
}

func resolveFactoryStepName(tk *models.StaffTask) string {
	name := factoryStepNames[tk.SOPStepID]
	if name == "" {
		name = tk.SOPStepID
	}
	switch tk.TaskKind {
	case models.TaskKindSetup:
		return "[SETUP] " + name
	case models.TaskKindRetrieve:
		return "[RETRIEVE] " + name
	case models.TaskKindFillIn:
		return "[FILL-IN] " + name
	}
	return name
}

// ─── SIMULATION ENGINE ────────────────────────────────────────────────────────

// factoryEvent mô tả một sự kiện ngoại lai tại thời điểm vTime (phút)
type factoryEvent struct {
	vTime   int
	handler func()
	label   string
}

// runFactorySimulation chạy vòng lặp virtual-time chung cho tất cả kịch bản.
func runFactorySimulation(
	t *testing.T,
	label string,
	nowBase time.Time,
	maxMinutes int,
	engine SchedulingEngine,
	disp Dispatcher,
	taskRepo *mockStaffTaskRepo,
	sopRepo *mockSOPRepo,
	machineRepo *mockMachineRepo,
	nodeID string,
	staffIDs []string,
	events []factoryEvent,
) []string {
	t.Helper()
	var simulatedLogs []string
	lastItemType := make(map[string]string)

	logSim := func(vTime int, msg string) {
		ts := fmt.Sprintf("T+%03d [%s]", vTime,
			nowBase.Add(time.Duration(vTime)*time.Minute).Format("15:04"))
		line := fmt.Sprintf("%s %s", ts, msg)
		simulatedLogs = append(simulatedLogs, line)
	}

	sort.Slice(events, func(i, j int) bool { return events[i].vTime < events[j].vTime })

	for vTime := 0; vTime <= maxMinutes; vTime++ {
		currentTime := nowBase.Add(time.Duration(vTime) * time.Minute)
		engine.(*schedulingEngine).now = func() time.Time { return currentTime } //nolint
		disp.(*dispatcher).now = func() time.Time { return currentTime } //nolint

		// Xử lý sự kiện ngoại lai
		for _, ev := range events {
			if ev.vTime == vTime {
				logSim(vTime, "⚡ EVENT: "+ev.label)
				ev.handler()
			}
		}

		tasks := taskRepo.tasks

		// ── Phase 1: Máy nướng chạy xong → task WAITING → PENDING ──────────
		for _, tk := range tasks {
			if tk.Status != models.TaskWaiting {
				continue
			}
			step := sopRepo.steps[tk.SOPStepID]
			if step == nil {
				continue
			}
			reqAtt := 0
			if step.RequiresAttentionAt != nil {
				reqAtt = *step.RequiresAttentionAt
			}
			retrieveStart := tk.ScheduledEnd.Add(-time.Duration(reqAtt) * time.Second)
			if !currentTime.Before(retrieveStart) {
				tk.Status = models.TaskPending
				logSim(vTime, fmt.Sprintf(
					"🔔 Máy hoàn thành → cần RETRIEVE: %s (Máy: %s)",
					resolveFactoryStepName(tk), tk.MachineID))
			}
		}

		// ── Phase 2: Nhân viên xử lý task ───────────────────────────────────
		for _, staff := range staffIDs {
			var activeTask *models.StaffTask
			var pendingTasks []*models.StaffTask

			for _, tk := range tasks {
				if tk.AssignedTo != staff {
					continue
				}
				switch tk.Status {
				case models.TaskActive:
					activeTask = tk
				case models.TaskPending:
					pendingTasks = append(pendingTasks, tk)
				}
			}

			sort.Slice(pendingTasks, func(i, j int) bool {
				return pendingTasks[i].ScheduledStart.Before(pendingTasks[j].ScheduledStart)
			})

			// Kiểm tra hoàn thành task hiện tại
			if activeTask != nil {
				step := sopRepo.steps[activeTask.SOPStepID]
				if step == nil {
					continue
				}
				var duration time.Duration
				switch activeTask.TaskKind {
				case models.TaskKindNormal, models.TaskKindFillIn:
					duration = time.Duration(step.Duration) * time.Second
				case models.TaskKindSetup:
					if step.ActiveTime != nil {
						duration = time.Duration(*step.ActiveTime) * time.Second
					}
				case models.TaskKindRetrieve:
					reqAtt := 0
					if step.RequiresAttentionAt != nil {
						reqAtt = *step.RequiresAttentionAt
					}
					duration = time.Duration(reqAtt) * time.Second
					if duration == 0 {
						duration = 1 * time.Minute
					}
				}

				if activeTask.StartedAt != nil && currentTime.Sub(*activeTask.StartedAt) >= duration {
					activeTask.Status = models.TaskDone
					endTime := currentTime
					activeTask.CompletedAt = &endTime
					logSim(vTime, fmt.Sprintf(
						"✅ %s hoàn thành: %s (Qty: %.0f)",
						staff, resolveFactoryStepName(activeTask), activeTask.TargetQty))

					// Giải phóng máy nếu RETRIEVE hoặc NORMAL
					if activeTask.MachineID != "" {
						if activeTask.TaskKind == models.TaskKindRetrieve ||
							activeTask.TaskKind == models.TaskKindNormal {
							if m, ok := machineRepo.machines[activeTask.MachineID]; ok {
								m.CurrentBatchID = nil
							}
						}
					}
					disp.Dispatch(t.Context(), nodeID)
					activeTask = nil
				}
			}

			// Bắt đầu task mới nếu rảnh
			if activeTask == nil {
				for _, tk := range pendingTasks {
					if tk.Status != models.TaskPending {
						continue
					}
					if currentTime.Before(tk.EarliestStart) || currentTime.Before(tk.ScheduledStart) {
						continue
					}
					// RETRIEVE chỉ bắt đầu khi gần đến giờ lấy
					if tk.TaskKind == models.TaskKindRetrieve {
						step := sopRepo.steps[tk.SOPStepID]
						reqAtt := 0
						if step != nil && step.RequiresAttentionAt != nil {
							reqAtt = *step.RequiresAttentionAt
						}
						retrieveStart := tk.ScheduledEnd.Add(-time.Duration(reqAtt) * time.Second)
						if currentTime.Before(retrieveStart) {
							continue
						}
					}

					tk.Status = models.TaskActive
					st := currentTime
					tk.StartedAt = &st

					itemType := ""
					if strings.Contains(tk.SOPStepID, "bun") {
						itemType = "Vỏ bánh burger"
					} else if strings.Contains(tk.SOPStepID, "patty") {
						itemType = "Patty bò"
					} else if strings.Contains(tk.SOPStepID, "sauce") {
						itemType = "Nước xốt"
					}

					if itemType != "" && itemType != lastItemType[staff] {
						// Only log transition if this is not the very first task of the shift
						if lastItemType[staff] != "" {
							logSim(vTime, fmt.Sprintf("💡 [CHUYỂN MÓN] %s bắt đầu chuyển sang làm %s", staff, itemType))
						}
						lastItemType[staff] = itemType
					}

					logSim(vTime, fmt.Sprintf(
						"▶️  %s bắt đầu: %s (Qty: %.0f, Máy: %s)",
						staff, resolveFactoryStepName(tk), tk.TargetQty, tk.MachineID))
					break
				}
			}
		}
	}

	fmt.Printf("\n════════════════════════════════════════\n")
	fmt.Printf("  VIRTUAL TIMELINE – %s\n", label)
	fmt.Printf("════════════════════════════════════════\n")
	for _, l := range simulatedLogs {
		fmt.Println(l)
	}
	fmt.Println()
	return simulatedLogs
}

// ─── COMMON ASSERTIONS ────────────────────────────────────────────────────────

// assertionsFactory chạy các kiểm tra chung sau khi simulation kết thúc
func assertionsFactory(t *testing.T, taskRepo *mockStaffTaskRepo, sopRepo *mockSOPRepo, staffIDs []string) {
	t.Helper()

	// A1: Tất cả task phải DONE hoặc CANCELLED
	t.Run("A1_AllTasksDone", func(t *testing.T) {
		incomplete := 0
		for _, tk := range taskRepo.tasks {
			if tk.Status != models.TaskDone && tk.Status != models.TaskCancelled {
				t.Errorf("Task %s [%s] chưa xong. Status=%s",
					tk.ID, resolveFactoryStepName(tk), tk.Status)
				incomplete++
			}
		}
		if incomplete == 0 {
			t.Logf("✅ Tất cả task đã DONE/CANCELLED")
		}
	})

	// A2: Không có nhân viên làm 2 task cùng lúc
	t.Run("A2_NoStaffOverlap", func(t *testing.T) {
		for _, staff := range staffIDs {
			var staffTasks []*models.StaffTask
			for _, tk := range taskRepo.tasks {
				if tk.AssignedTo == staff && tk.StartedAt != nil && tk.CompletedAt != nil {
					staffTasks = append(staffTasks, tk)
				}
			}
			for i := 0; i < len(staffTasks); i++ {
				for j := i + 1; j < len(staffTasks); j++ {
					a, b := staffTasks[i], staffTasks[j]
					if a.StartedAt.Before(*b.CompletedAt) && b.StartedAt.Before(*a.CompletedAt) {
						t.Errorf("❌ %s: task chồng chéo!\n  → %s (%s–%s)\n  → %s (%s–%s)",
							staff,
							resolveFactoryStepName(a),
							a.StartedAt.Format("15:04"), a.CompletedAt.Format("15:04"),
							resolveFactoryStepName(b),
							b.StartedAt.Format("15:04"), b.CompletedAt.Format("15:04"),
						)
					}
				}
			}
		}
	})

	// A3: Machine capacity check (log only – chi tiết phụ thuộc slot model thực tế)
	t.Run("A3_NoMachineCapacityExceeded", func(t *testing.T) {
		t.Logf("ℹ️  Machine capacity check: cần mở rộng theo SlotConsumption model")
	})
}

// =============================================================================
// SC-1: HAPPY PATH – đủ 3 nhân viên, 2 máy nướng, target đầy đủ
// =============================================================================

func TestFactory_SC1_HappyPath(t *testing.T) {
	_, poRepo, sopRepo, batchRepo, shiftRepo, taskRepo, machineRepo, disp, engine :=
		setupTestEnv()
	_ = batchRepo

	nowBase := time.Date(2026, 7, 21, 6, 0, 0, 0, time.Local) // 06:00 sáng
	nodeID := "factory_f"
	staffIDs := []string{"f_staff_1", "f_staff_2", "f_staff_3"}

	// ── Shifts ──────────────────────────────────────────────────────────────
	for i, sid := range staffIDs {
		shiftRepo.shifts[fmt.Sprintf("shift_%d", i+1)] = &models.StaffShift{
			ID: fmt.Sprintf("shift_%d", i+1), NodeID: nodeID,
			StaffID: sid, Status: models.ShiftActive,
		}
	}

	// ── 2 máy nướng cỡ lớn (24 slots mỗi máy) ──────────────────────────────
	machineRepo.machines["m_grill_A"] = &models.Machine{
		ID: "m_grill_A", NodeID: nodeID,
		EquipmentTypeID: "grill", Status: models.MachineIdle, MaxCapacity: 24,
	}
	machineRepo.machines["m_grill_B"] = &models.Machine{
		ID: "m_grill_B", NodeID: nodeID,
		EquipmentTypeID: "grill", Status: models.MachineIdle, MaxCapacity: 24,
	}
	machineRepo.machines["m_mixer"] = &models.Machine{
		ID: "m_mixer", NodeID: nodeID,
		EquipmentTypeID: "mixer", Status: models.MachineIdle, MaxCapacity: 1,
	}
	machineRepo.machines["m_proofer"] = &models.Machine{
		ID: "m_proofer", NodeID: nodeID,
		EquipmentTypeID: "proofer", Status: models.MachineIdle, MaxCapacity: 1,
	}

	// ── SOP: Vỏ bánh burger ─────────────────────────────────────────────────
	// 200 bun, 2 máy × 24 slots = 48 bun/mẻ → ceil(200/48) = 5 vòng nướng
	sopBun := "sop_bun_sc1"
	sopRepo.sops[sopBun] = &models.SOP{ID: sopBun}
	sopRepo.steps["sc1_bun_dry"] = &models.SOPStep{
		ID: "sc1_bun_dry", SOPID: sopBun, SeqNo: 1,
		Duration: 10 * 60,
	}
	sopRepo.steps["sc1_bun_mix"] = &models.SOPStep{
		ID: "sc1_bun_mix", SOPID: sopBun, SeqNo: 2, DependsOn: []string{"sc1_bun_dry"},
		EquipmentTypeID: ptrStrF("mixer"), IsIdleStep: true,
		Duration: 15 * 60, ActiveTime: ptrIntF(3 * 60),
	}
	sopRepo.steps["sc1_bun_proof"] = &models.SOPStep{
		ID: "sc1_bun_proof", SOPID: sopBun, SeqNo: 3, DependsOn: []string{"sc1_bun_mix"},
		EquipmentTypeID: ptrStrF("proofer"), IsIdleStep: true,
		Duration: 45 * 60, ActiveTime: ptrIntF(5 * 60),
	}
	sopRepo.steps["sc1_bun_shape"] = &models.SOPStep{
		ID: "sc1_bun_shape", SOPID: sopBun, SeqNo: 4, DependsOn: []string{"sc1_bun_proof"},
		Duration: 20 * 60,
	}
	sopRepo.steps["sc1_bun_bake"] = &models.SOPStep{
		ID: "sc1_bun_bake", SOPID: sopBun, SeqNo: 5, DependsOn: []string{"sc1_bun_shape"},
		EquipmentTypeID: ptrStrF("grill"), IsIdleStep: true,
		Duration: 18 * 60, ActiveTime: ptrIntF(3 * 60),
		SlotConsumption: 1.0,
	}

	// ── SOP: Patty bò ───────────────────────────────────────────────────────
	// 300 miếng × 120g; 2 máy × 24 slots = 48/mẻ → ceil(300/48) = 7 mẻ nướng
	sopPatty := "sop_patty_sc1"
	sopRepo.sops[sopPatty] = &models.SOP{ID: sopPatty}
	sopRepo.steps["sc1_patty_prep"] = &models.SOPStep{
		ID: "sc1_patty_prep", SOPID: sopPatty, SeqNo: 1,
		Duration: 15 * 60,
	}
	sopRepo.steps["sc1_patty_mix"] = &models.SOPStep{
		ID: "sc1_patty_mix", SOPID: sopPatty, SeqNo: 2, DependsOn: []string{"sc1_patty_prep"},
		EquipmentTypeID: ptrStrF("mixer"), IsIdleStep: true,
		Duration: 12 * 60, ActiveTime: ptrIntF(2 * 60),
	}
	sopRepo.steps["sc1_patty_weigh"] = &models.SOPStep{
		ID: "sc1_patty_weigh", SOPID: sopPatty, SeqNo: 3, DependsOn: []string{"sc1_patty_mix"},
		Duration: 30 * 60, // chia & cân 300 viên – thủ công
	}
	sopRepo.steps["sc1_patty_mold"] = &models.SOPStep{
		ID: "sc1_patty_mold", SOPID: sopPatty, SeqNo: 4, DependsOn: []string{"sc1_patty_weigh"},
		Duration: 20 * 60,
	}
	sopRepo.steps["sc1_patty_grill"] = &models.SOPStep{
		ID: "sc1_patty_grill", SOPID: sopPatty, SeqNo: 5, DependsOn: []string{"sc1_patty_mold"},
		EquipmentTypeID: ptrStrF("grill"), IsIdleStep: true,
		Duration: 10 * 60, ActiveTime: ptrIntF(2 * 60),
		SlotConsumption: 1.0,
	}

	// ── SOP: Nước xốt burger ────────────────────────────────────────────────
	// 1 lô duy nhất, không cần máy chuyên dụng
	sopSauce := "sop_sauce_sc1"
	sopRepo.sops[sopSauce] = &models.SOP{ID: sopSauce}
	sopRepo.steps["sc1_sauce_prep"] = &models.SOPStep{
		ID: "sc1_sauce_prep", SOPID: sopSauce, SeqNo: 1, Duration: 10 * 60,
	}
	sopRepo.steps["sc1_sauce_mix"] = &models.SOPStep{
		ID: "sc1_sauce_mix", SOPID: sopSauce, SeqNo: 2,
		DependsOn: []string{"sc1_sauce_prep"}, Duration: 20 * 60,
	}
	sopRepo.steps["sc1_sauce_pack"] = &models.SOPStep{
		ID: "sc1_sauce_pack", SOPID: sopSauce, SeqNo: 3,
		DependsOn: []string{"sc1_sauce_mix"}, Duration: 10 * 60,
	}

	// ── Production Orders ────────────────────────────────────────────────────
	poBun := &models.ProductionOrder{
		ID: "po_bun_sc1", NodeID: nodeID, SOPID: sopBun,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 200,
	}
	poPatty := &models.ProductionOrder{
		ID: "po_patty_sc1", NodeID: nodeID, SOPID: sopPatty,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 300,
	}
	poSauce := &models.ProductionOrder{
		ID: "po_sauce_sc1", NodeID: nodeID, SOPID: sopSauce,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 1,
	}
	poRepo.pos["po_bun_sc1"] = poBun
	poRepo.pos["po_patty_sc1"] = poPatty
	poRepo.pos["po_sauce_sc1"] = poSauce

	events := []factoryEvent{
		{vTime: 0, label: "Ca sáng bắt đầu – Schedule tất cả 3 PO", handler: func() {
			for _, poID := range []string{"po_bun_sc1", "po_patty_sc1", "po_sauce_sc1"} {
				if _, err := engine.SchedulePO(t.Context(), poID); err != nil {
					t.Errorf("SchedulePO %s: %v", poID, err)
				}
			}
			disp.Dispatch(t.Context(), nodeID)
		}},
	}

	logs := runFactorySimulation(
		t, "SC-1: HAPPY PATH",
		nowBase, 300, // 5 giờ (06:00 – 11:00)
		engine, disp, taskRepo, sopRepo, machineRepo,
		nodeID, staffIDs, events,
	)

	assertionsFactory(t, taskRepo, sopRepo, staffIDs)

	// A4: Hoàn thành trước 11:00 (T+300 phút)
	t.Run("A4_CompletedWithin5Hours", func(t *testing.T) {
		deadline := nowBase.Add(300 * time.Minute)
		overdue := 0
		for _, tk := range taskRepo.tasks {
			if tk.CompletedAt != nil && tk.CompletedAt.After(deadline) {
				t.Errorf("❌ Task %s [%s] hoàn thành trễ: %s (deadline: %s)",
					tk.ID, resolveFactoryStepName(tk),
					tk.CompletedAt.Format("15:04"), deadline.Format("15:04"))
				overdue++
			}
		}
		if overdue == 0 {
			t.Logf("✅ Tất cả task hoàn thành trước 11:00")
		}
		t.Logf("📋 SC-1 tổng %d log entries", len(logs))
	})
}

// =============================================================================
// SC-2: MACHINE DOWN – m_grill_A hỏng lúc T+60 (07:00)
//         Chỉ còn máy B (24 slots) để nướng 300 patty
// =============================================================================

func TestFactory_SC2_MachineDown(t *testing.T) {
	_, poRepo, sopRepo, batchRepo, shiftRepo, taskRepo, machineRepo, disp, engine :=
		setupTestEnv()
	_ = batchRepo

	nowBase := time.Date(2026, 7, 21, 6, 0, 0, 0, time.Local)
	nodeID := "factory_f"
	staffIDs := []string{"f_staff_1", "f_staff_2", "f_staff_3"}

	for i, sid := range staffIDs {
		shiftRepo.shifts[fmt.Sprintf("shift_%d", i+1)] = &models.StaffShift{
			ID: fmt.Sprintf("shift_%d", i+1), NodeID: nodeID,
			StaffID: sid, Status: models.ShiftActive,
		}
	}

	// Khởi tạo 2 máy nướng – đều ONLINE lúc đầu
	machineRepo.machines["m_grill_A"] = &models.Machine{
		ID: "m_grill_A", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}
	machineRepo.machines["m_grill_B"] = &models.Machine{
		ID: "m_grill_B", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}

	// SOP patty (đơn giản để tập trung vào grill bottleneck)
	sopPatty := "sop_patty_sc2"
	sopRepo.sops[sopPatty] = &models.SOP{ID: sopPatty}
	sopRepo.steps["sc2_prep"] = &models.SOPStep{
		ID: "sc2_prep", SOPID: sopPatty, SeqNo: 1, Duration: 15 * 60,
	}
	sopRepo.steps["sc2_weigh"] = &models.SOPStep{
		ID: "sc2_weigh", SOPID: sopPatty, SeqNo: 2,
		DependsOn: []string{"sc2_prep"}, Duration: 30 * 60,
	}
	sopRepo.steps["sc2_mold"] = &models.SOPStep{
		ID: "sc2_mold", SOPID: sopPatty, SeqNo: 3,
		DependsOn: []string{"sc2_weigh"}, Duration: 20 * 60,
	}
	sopRepo.steps["sc2_grill"] = &models.SOPStep{
		ID: "sc2_grill", SOPID: sopPatty, SeqNo: 4,
		DependsOn: []string{"sc2_mold"},
		EquipmentTypeID: ptrStrF("grill"), IsIdleStep: true,
		Duration: 10 * 60, ActiveTime: ptrIntF(2 * 60),
		SlotConsumption: 1.0,
	}

	poPatty := &models.ProductionOrder{
		ID: "po_patty_sc2", NodeID: nodeID, SOPID: sopPatty,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 300,
	}
	poRepo.pos["po_patty_sc2"] = poPatty

	events := []factoryEvent{
		{vTime: 0, label: "Bắt đầu ca – Schedule 300 patty (2 máy nướng)", handler: func() {
			if _, err := engine.SchedulePO(t.Context(), poPatty.ID); err != nil {
				t.Errorf("SchedulePO patty: %v", err)
			}
			disp.Dispatch(t.Context(), nodeID)
		}},
		{
			// T+60 = 07:00: máy A đột ngột hỏng
			vTime: 60,
			label: "⚠️  m_grill_A HỎng – chuyển OFFLINE, re-dispatch",
			handler: func() {
				machineRepo.machines["m_grill_A"].Status = "OFFLINE"
				// Re-dispatch để engine biết reschedule các batch đang chờ máy A
				disp.Dispatch(t.Context(), nodeID)
			},
		},
	}

	logs := runFactorySimulation(
		t, "SC-2: MACHINE DOWN (m_grill_A hỏng T+60)",
		nowBase, 420, // 7 giờ – thêm buffer vì mất 1 máy
		engine, disp, taskRepo, sopRepo, machineRepo,
		nodeID, staffIDs, events,
	)

	assertionsFactory(t, taskRepo, sopRepo, staffIDs)

	// A4: Sau khi hỏng, không task nào được bắt đầu trên máy A
	t.Run("A4_MachineA_NotUsedAfterBreakdown", func(t *testing.T) {
		breakdownTime := nowBase.Add(60 * time.Minute)
		violations := 0
		for _, tk := range taskRepo.tasks {
			if tk.MachineID == "m_grill_A" && tk.StartedAt != nil {
				if tk.StartedAt.After(breakdownTime) {
					t.Errorf("❌ Task %s bắt đầu trên m_grill_A SAU khi hỏng: %s",
						tk.ID, tk.StartedAt.Format("15:04"))
					violations++
				}
			}
		}
		if violations == 0 {
			t.Logf("✅ Không có task nào dùng m_grill_A sau khi hỏng")
		}
		t.Logf("📋 SC-2 tổng %d log entries", len(logs))
	})

	// A5: Tất cả task nướng sau T+60 phải dùng máy B
	t.Run("A5_AllGrillingAfterBreakdown_UseMachineB", func(t *testing.T) {
		breakdownTime := nowBase.Add(60 * time.Minute)
		for _, tk := range taskRepo.tasks {
			if tk.SOPStepID == "sc2_grill" && tk.StartedAt != nil {
				if tk.StartedAt.After(breakdownTime) && tk.MachineID != "m_grill_B" {
					t.Errorf("❌ Task nướng sau T+60 dùng máy sai: %s (expected m_grill_B)", tk.MachineID)
				}
			}
		}
	})
}

// =============================================================================
// SC-3: STAFF SHORTAGE – chỉ 1 nhân viên duy nhất thay vì 3
//         Kiểm tra: bottleneck, sequencing, không deadlock
// =============================================================================

func TestFactory_SC3_StaffShortage(t *testing.T) {
	_, poRepo, sopRepo, batchRepo, shiftRepo, taskRepo, machineRepo, disp, engine :=
		setupTestEnv()
	_ = batchRepo

	nowBase := time.Date(2026, 7, 21, 6, 0, 0, 0, time.Local)
	nodeID := "factory_f"
	staffIDs := []string{"f_staff_1"} // Chỉ 1 nhân viên!

	shiftRepo.shifts["shift_1"] = &models.StaffShift{
		ID: "shift_1", NodeID: nodeID,
		StaffID: "f_staff_1", Status: models.ShiftActive,
	}

	machineRepo.machines["m_grill_A"] = &models.Machine{
		ID: "m_grill_A", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}
	machineRepo.machines["m_grill_B"] = &models.Machine{
		ID: "m_grill_B", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}

	// SOP sauce (đơn giản, không cần máy – ưu tiên làm trước vì ngắn nhất)
	sopSauce := "sop_sauce_sc3"
	sopRepo.sops[sopSauce] = &models.SOP{ID: sopSauce}
	sopRepo.steps["sc3_sauce_prep"] = &models.SOPStep{
		ID: "sc3_sauce_prep", SOPID: sopSauce, SeqNo: 1, Duration: 10 * 60,
	}
	sopRepo.steps["sc3_sauce_mix"] = &models.SOPStep{
		ID: "sc3_sauce_mix", SOPID: sopSauce, SeqNo: 2,
		DependsOn: []string{"sc3_sauce_prep"}, Duration: 20 * 60,
	}
	sopRepo.steps["sc3_sauce_pack"] = &models.SOPStep{
		ID: "sc3_sauce_pack", SOPID: sopSauce, SeqNo: 3,
		DependsOn: []string{"sc3_sauce_mix"}, Duration: 10 * 60,
	}

	// SOP patty (cần máy grill)
	sopPatty := "sop_patty_sc3"
	sopRepo.sops[sopPatty] = &models.SOP{ID: sopPatty}
	sopRepo.steps["sc3_patty_prep"] = &models.SOPStep{
		ID: "sc3_patty_prep", SOPID: sopPatty, SeqNo: 1, Duration: 15 * 60,
	}
	sopRepo.steps["sc3_patty_weigh"] = &models.SOPStep{
		ID: "sc3_patty_weigh", SOPID: sopPatty, SeqNo: 2,
		DependsOn: []string{"sc3_patty_prep"}, Duration: 30 * 60,
	}
	sopRepo.steps["sc3_patty_grill"] = &models.SOPStep{
		ID: "sc3_patty_grill", SOPID: sopPatty, SeqNo: 3,
		DependsOn: []string{"sc3_patty_weigh"},
		EquipmentTypeID: ptrStrF("grill"), IsIdleStep: true,
		Duration: 10 * 60, ActiveTime: ptrIntF(2 * 60), SlotConsumption: 1.0,
	}

	poSauce := &models.ProductionOrder{
		ID: "po_sauce_sc3", NodeID: nodeID, SOPID: sopSauce,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 1,
	}
	poPatty := &models.ProductionOrder{
		// Giảm xuống 100 cho test nhanh hơn – stress vẫn rõ vì chỉ 1 người
		ID: "po_patty_sc3", NodeID: nodeID, SOPID: sopPatty,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 100,
	}
	poRepo.pos["po_sauce_sc3"] = poSauce
	poRepo.pos["po_patty_sc3"] = poPatty

	events := []factoryEvent{
		{vTime: 0, label: "1 nhân viên duy nhất – Schedule sauce + patty", handler: func() {
			if _, err := engine.SchedulePO(t.Context(), poSauce.ID); err != nil {
				t.Errorf("SchedulePO sauce: %v", err)
			}
			if _, err := engine.SchedulePO(t.Context(), poPatty.ID); err != nil {
				t.Errorf("SchedulePO patty: %v", err)
			}
			disp.Dispatch(t.Context(), nodeID)
		}},
	}

	logs := runFactorySimulation(
		t, "SC-3: STAFF SHORTAGE (1 nhân viên)",
		nowBase, 480, // 8 giờ buffer
		engine, disp, taskRepo, sopRepo, machineRepo,
		nodeID, staffIDs, events,
	)

	assertionsFactory(t, taskRepo, sopRepo, staffIDs)

	// A4: Sauce phải hoàn thành trước khi patty xong (sauce ngắn hơn và ưu tiên cao hơn)
	t.Run("A4_SauceBeforePatty", func(t *testing.T) {
		var sauceDone, pattyDone *time.Time
		for _, tk := range taskRepo.tasks {
			if tk.POID == "po_sauce_sc3" && tk.CompletedAt != nil {
				if sauceDone == nil || tk.CompletedAt.After(*sauceDone) {
					sauceDone = tk.CompletedAt
				}
			}
			if tk.POID == "po_patty_sc3" && tk.CompletedAt != nil {
				if pattyDone == nil || tk.CompletedAt.After(*pattyDone) {
					pattyDone = tk.CompletedAt
				}
			}
		}
		t.Logf("📋 SC-3: Sauce xong lúc %v | Patty xong lúc %v | Logs=%d",
			sauceDone, pattyDone, len(logs))
	})

	// A5: Nhân viên không bị idle quá 10 phút liên tục trong giờ cao điểm
	t.Run("A5_NoLongIdle", func(t *testing.T) {
		var staffTasks []*models.StaffTask
		for _, tk := range taskRepo.tasks {
			if tk.AssignedTo == "f_staff_1" && tk.StartedAt != nil && tk.CompletedAt != nil {
				staffTasks = append(staffTasks, tk)
			}
		}
		sort.Slice(staffTasks, func(i, j int) bool {
			return staffTasks[i].StartedAt.Before(*staffTasks[j].StartedAt)
		})
		maxIdleAllowed := 10 * time.Minute
		for i := 1; i < len(staffTasks); i++ {
			idle := staffTasks[i].StartedAt.Sub(*staffTasks[i-1].CompletedAt)
			if idle > maxIdleAllowed {
				t.Logf("⚠️  f_staff_1 idle %v giữa task %s và %s",
					idle, staffTasks[i-1].ID, staffTasks[i].ID)
			}
		}
	})
}

// =============================================================================
// SC-4: RUSH ORDER – lúc T+120 (08:00) nhận thêm 60 patty gấp từ S
//         Engine phải reschedule real-time, không ảnh hưởng PO gốc
// =============================================================================

func TestFactory_SC4_RushOrder(t *testing.T) {
	_, poRepo, sopRepo, batchRepo, shiftRepo, taskRepo, machineRepo, disp, engine :=
		setupTestEnv()
	_ = batchRepo

	nowBase := time.Date(2026, 7, 21, 6, 0, 0, 0, time.Local)
	nodeID := "factory_f"
	staffIDs := []string{"f_staff_1", "f_staff_2", "f_staff_3"}

	for i, sid := range staffIDs {
		shiftRepo.shifts[fmt.Sprintf("shift_%d", i+1)] = &models.StaffShift{
			ID: fmt.Sprintf("shift_%d", i+1), NodeID: nodeID,
			StaffID: sid, Status: models.ShiftActive,
		}
	}

	machineRepo.machines["m_grill_A"] = &models.Machine{
		ID: "m_grill_A", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}
	machineRepo.machines["m_grill_B"] = &models.Machine{
		ID: "m_grill_B", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}

	sopPatty := "sop_patty_sc4"
	sopRepo.sops[sopPatty] = &models.SOP{ID: sopPatty}
	sopRepo.steps["sc4_prep"] = &models.SOPStep{
		ID: "sc4_prep", SOPID: sopPatty, SeqNo: 1, Duration: 15 * 60,
	}
	sopRepo.steps["sc4_weigh"] = &models.SOPStep{
		ID: "sc4_weigh", SOPID: sopPatty, SeqNo: 2,
		DependsOn: []string{"sc4_prep"}, Duration: 30 * 60,
	}
	sopRepo.steps["sc4_mold"] = &models.SOPStep{
		ID: "sc4_mold", SOPID: sopPatty, SeqNo: 3,
		DependsOn: []string{"sc4_weigh"}, Duration: 20 * 60,
	}
	sopRepo.steps["sc4_grill"] = &models.SOPStep{
		ID: "sc4_grill", SOPID: sopPatty, SeqNo: 4,
		DependsOn: []string{"sc4_mold"},
		EquipmentTypeID: ptrStrF("grill"), IsIdleStep: true,
		Duration: 10 * 60, ActiveTime: ptrIntF(2 * 60), SlotConsumption: 1.0,
	}

	// PO gốc: 300 patty (bình thường)
	poMain := &models.ProductionOrder{
		ID: "po_patty_main_sc4", NodeID: nodeID, SOPID: sopPatty,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 300,
	}
	// PO rush: 60 patty thêm (sẽ inject vào T+120)
	rushCreatedAt := nowBase.Add(120 * time.Minute)
	poRush := &models.ProductionOrder{
		ID: "po_patty_rush_sc4", NodeID: nodeID, SOPID: sopPatty,
		Status: models.POInProgress, CreatedAt: rushCreatedAt, TargetQty: 60,
	}
	poRepo.pos["po_patty_main_sc4"] = poMain

	events := []factoryEvent{
		{vTime: 0, label: "Bắt đầu ca – Schedule 300 patty", handler: func() {
			if _, err := engine.SchedulePO(t.Context(), poMain.ID); err != nil {
				t.Errorf("SchedulePO main: %v", err)
			}
			disp.Dispatch(t.Context(), nodeID)
		}},
		{
			vTime: 120,
			label: "🚨 RUSH ORDER từ S: thêm 60 patty gấp! Re-schedule",
			handler: func() {
				poRepo.pos["po_patty_rush_sc4"] = poRush
				if _, err := engine.SchedulePO(t.Context(), poRush.ID); err != nil {
					t.Errorf("SchedulePO rush: %v", err)
				}
				disp.Dispatch(t.Context(), nodeID)
			},
		},
	}

	logs := runFactorySimulation(
		t, "SC-4: RUSH ORDER (+60 patty lúc T+120 / 08:00)",
		nowBase, 360, // 6 giờ
		engine, disp, taskRepo, sopRepo, machineRepo,
		nodeID, staffIDs, events,
	)

	assertionsFactory(t, taskRepo, sopRepo, staffIDs)

	// A4: Rush order tạo được task
	t.Run("A4_RushOrderGotTasks", func(t *testing.T) {
		rushTasks, _ := taskRepo.FindByPO(t.Context(), "po_patty_rush_sc4")
		if len(rushTasks) == 0 {
			t.Error("❌ Rush order không tạo được task nào!")
		} else {
			t.Logf("✅ Rush order tạo %d tasks sau khi inject T+120", len(rushTasks))
		}
		t.Logf("📋 SC-4 tổng %d log entries", len(logs))
	})

	// A5: PO gốc không bị cancel hoặc bị lùi quá 30 phút so với schedule gốc
	t.Run("A5_MainOrderNotDisrupted", func(t *testing.T) {
		mainTasks, _ := taskRepo.FindByPO(t.Context(), "po_patty_main_sc4")
		cancelled := 0
		for _, tk := range mainTasks {
			if tk.Status == models.TaskCancelled {
				cancelled++
			}
		}
		if cancelled > 0 {
			t.Errorf("❌ PO gốc có %d task bị cancel do rush order", cancelled)
		} else {
			t.Logf("✅ PO gốc không bị ảnh hưởng (%d tasks intact)", len(mainTasks))
		}
	})
}

// =============================================================================
// SC-5: FULL BLAST – 200 bun + 300 patty + 1L sauce đồng thời từ T=0
//         Kiểm tra: không deadlock, không double-booking máy, không staff overlap
// =============================================================================

func TestFactory_SC5_FullBlast(t *testing.T) {
	_, poRepo, sopRepo, batchRepo, shiftRepo, taskRepo, machineRepo, disp, engine :=
		setupTestEnv()
	_ = batchRepo

	nowBase := time.Date(2026, 7, 21, 6, 0, 0, 0, time.Local)
	nodeID := "factory_f"
	staffIDs := []string{"f_staff_1", "f_staff_2", "f_staff_3"}

	for i, sid := range staffIDs {
		shiftRepo.shifts[fmt.Sprintf("shift_%d", i+1)] = &models.StaffShift{
			ID: fmt.Sprintf("shift_%d", i+1), NodeID: nodeID,
			StaffID: sid, Status: models.ShiftActive,
		}
	}

	// Đủ thiết bị
	machineRepo.machines["m_grill_A"] = &models.Machine{
		ID: "m_grill_A", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}
	machineRepo.machines["m_grill_B"] = &models.Machine{
		ID: "m_grill_B", NodeID: nodeID, EquipmentTypeID: "grill",
		Status: models.MachineIdle, MaxCapacity: 24,
	}
	machineRepo.machines["m_mixer"] = &models.Machine{
		ID: "m_mixer", NodeID: nodeID, EquipmentTypeID: "mixer",
		Status: models.MachineIdle, MaxCapacity: 1,
	}
	machineRepo.machines["m_proofer"] = &models.Machine{
		ID: "m_proofer", NodeID: nodeID, EquipmentTypeID: "proofer",
		Status: models.MachineIdle, MaxCapacity: 1,
	}

	// SOP bun (đầy đủ 5 bước)
	sopBun := "sop_bun_sc5"
	sopRepo.sops[sopBun] = &models.SOP{ID: sopBun}
	sopRepo.steps["sc5_bun_dry"] = &models.SOPStep{
		ID: "sc5_bun_dry", SOPID: sopBun, SeqNo: 1, Duration: 10 * 60,
	}
	sopRepo.steps["sc5_bun_mix"] = &models.SOPStep{
		ID: "sc5_bun_mix", SOPID: sopBun, SeqNo: 2, DependsOn: []string{"sc5_bun_dry"},
		EquipmentTypeID: ptrStrF("mixer"), IsIdleStep: true,
		Duration: 15 * 60, ActiveTime: ptrIntF(3 * 60),
	}
	sopRepo.steps["sc5_bun_proof"] = &models.SOPStep{
		ID: "sc5_bun_proof", SOPID: sopBun, SeqNo: 3, DependsOn: []string{"sc5_bun_mix"},
		EquipmentTypeID: ptrStrF("proofer"), IsIdleStep: true,
		Duration: 45 * 60, ActiveTime: ptrIntF(5 * 60),
	}
	sopRepo.steps["sc5_bun_shape"] = &models.SOPStep{
		ID: "sc5_bun_shape", SOPID: sopBun, SeqNo: 4, DependsOn: []string{"sc5_bun_proof"},
		Duration: 20 * 60,
	}
	sopRepo.steps["sc5_bun_bake"] = &models.SOPStep{
		ID: "sc5_bun_bake", SOPID: sopBun, SeqNo: 5, DependsOn: []string{"sc5_bun_shape"},
		EquipmentTypeID: ptrStrF("grill"), IsIdleStep: true,
		Duration: 18 * 60, ActiveTime: ptrIntF(3 * 60), SlotConsumption: 1.0,
	}

	// SOP patty (5 bước)
	sopPatty := "sop_patty_sc5"
	sopRepo.sops[sopPatty] = &models.SOP{ID: sopPatty}
	sopRepo.steps["sc5_patty_prep"] = &models.SOPStep{
		ID: "sc5_patty_prep", SOPID: sopPatty, SeqNo: 1, Duration: 15 * 60,
	}
	sopRepo.steps["sc5_patty_mix"] = &models.SOPStep{
		ID: "sc5_patty_mix", SOPID: sopPatty, SeqNo: 2, DependsOn: []string{"sc5_patty_prep"},
		EquipmentTypeID: ptrStrF("mixer"), IsIdleStep: true,
		Duration: 12 * 60, ActiveTime: ptrIntF(2 * 60),
	}
	sopRepo.steps["sc5_patty_weigh"] = &models.SOPStep{
		ID: "sc5_patty_weigh", SOPID: sopPatty, SeqNo: 3, DependsOn: []string{"sc5_patty_mix"},
		Duration: 30 * 60,
	}
	sopRepo.steps["sc5_patty_mold"] = &models.SOPStep{
		ID: "sc5_patty_mold", SOPID: sopPatty, SeqNo: 4, DependsOn: []string{"sc5_patty_weigh"},
		Duration: 20 * 60,
	}
	sopRepo.steps["sc5_patty_grill"] = &models.SOPStep{
		ID: "sc5_patty_grill", SOPID: sopPatty, SeqNo: 5, DependsOn: []string{"sc5_patty_mold"},
		EquipmentTypeID: ptrStrF("grill"), IsIdleStep: true,
		Duration: 10 * 60, ActiveTime: ptrIntF(2 * 60), SlotConsumption: 1.0,
	}

	// SOP sauce (3 bước – không máy)
	sopSauce := "sop_sauce_sc5"
	sopRepo.sops[sopSauce] = &models.SOP{ID: sopSauce}
	sopRepo.steps["sc5_sauce_prep"] = &models.SOPStep{
		ID: "sc5_sauce_prep", SOPID: sopSauce, SeqNo: 1, Duration: 10 * 60,
	}
	sopRepo.steps["sc5_sauce_mix"] = &models.SOPStep{
		ID: "sc5_sauce_mix", SOPID: sopSauce, SeqNo: 2,
		DependsOn: []string{"sc5_sauce_prep"}, Duration: 20 * 60,
	}
	sopRepo.steps["sc5_sauce_pack"] = &models.SOPStep{
		ID: "sc5_sauce_pack", SOPID: sopSauce, SeqNo: 3,
		DependsOn: []string{"sc5_sauce_mix"}, Duration: 10 * 60,
	}

	poBun := &models.ProductionOrder{
		ID: "po_bun_sc5", NodeID: nodeID, SOPID: sopBun,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 200,
	}
	poPatty := &models.ProductionOrder{
		ID: "po_patty_sc5", NodeID: nodeID, SOPID: sopPatty,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 300,
	}
	poSauce := &models.ProductionOrder{
		ID: "po_sauce_sc5", NodeID: nodeID, SOPID: sopSauce,
		Status: models.POInProgress, CreatedAt: nowBase, TargetQty: 1,
	}
	poRepo.pos["po_bun_sc5"] = poBun
	poRepo.pos["po_patty_sc5"] = poPatty
	poRepo.pos["po_sauce_sc5"] = poSauce

	events := []factoryEvent{
		{vTime: 0, label: "🔥 FULL BLAST – Schedule đồng thời BUN + PATTY + SAUCE", handler: func() {
			for _, poID := range []string{"po_bun_sc5", "po_patty_sc5", "po_sauce_sc5"} {
				if _, err := engine.SchedulePO(t.Context(), poID); err != nil {
					t.Errorf("SchedulePO %s: %v", poID, err)
				}
			}
			disp.Dispatch(t.Context(), nodeID)
		}},
	}

	logs := runFactorySimulation(
		t, "SC-5: FULL BLAST (BUN + PATTY + SAUCE cùng lúc)",
		nowBase, 480, // 8 giờ
		engine, disp, taskRepo, sopRepo, machineRepo,
		nodeID, staffIDs, events,
	)

	assertionsFactory(t, taskRepo, sopRepo, staffIDs)

	// A4: Không có 2 SETUP task dùng cùng 1 máy chồng chéo nhau
	t.Run("A4_NoMachineDoubleBooking", func(t *testing.T) {
		type machineInterval struct {
			start  time.Time
			end    time.Time
			taskID string
		}
		machineSlots := make(map[string][]machineInterval)
		for _, tk := range taskRepo.tasks {
			if tk.MachineID != "" && tk.StartedAt != nil && tk.CompletedAt != nil &&
				tk.TaskKind == models.TaskKindSetup {
				machineSlots[tk.MachineID] = append(machineSlots[tk.MachineID], machineInterval{
					start:  *tk.StartedAt,
					end:    *tk.CompletedAt,
					taskID: tk.ID,
				})
			}
		}
		doubleBooks := 0
		for machID, intervals := range machineSlots {
			for i := 0; i < len(intervals); i++ {
				for j := i + 1; j < len(intervals); j++ {
					a, b := intervals[i], intervals[j]
					if a.start.Before(b.end) && b.start.Before(a.end) {
						t.Errorf("❌ Double booking %s: task %s (%s–%s) XÁO TRỘN %s (%s–%s)",
							machID, a.taskID,
							a.start.Format("15:04"), a.end.Format("15:04"),
							b.taskID,
							b.start.Format("15:04"), b.end.Format("15:04"))
						doubleBooks++
					}
				}
			}
		}
		if doubleBooks == 0 {
			t.Logf("✅ Không có double booking trên bất kỳ máy nào")
		}
		t.Logf("📋 SC-5 tổng %d log entries", len(logs))
	})

	// A5: Sauce (ngắn nhất) phải hoàn thành trước 07:00 (T+60)
	t.Run("A5_SauceFinishesEarly", func(t *testing.T) {
		threshold := nowBase.Add(60 * time.Minute)
		var sauceLastDone *time.Time
		for _, tk := range taskRepo.tasks {
			if tk.POID == "po_sauce_sc5" && tk.CompletedAt != nil {
				if sauceLastDone == nil || tk.CompletedAt.After(*sauceLastDone) {
					sauceLastDone = tk.CompletedAt
				}
			}
		}
		if sauceLastDone != nil {
			if sauceLastDone.After(threshold) {
				t.Logf("⚠️  Sauce hoàn thành lúc %s (sau %s) – có thể bị tranh tài nguyên nhân viên",
					sauceLastDone.Format("15:04"), threshold.Format("15:04"))
			} else {
				t.Logf("✅ Sauce hoàn thành lúc %s (trước %s)",
					sauceLastDone.Format("15:04"), threshold.Format("15:04"))
			}
		}
	})
}
